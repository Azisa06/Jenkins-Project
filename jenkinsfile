pipeline {
    agent any
    environment {
        DOCKER_IMAGE_REPO = 'azisa06/fastapi-hello'
        DOCKER_FILE_PATH = './backend/Dockerfile'
        BUILD_CONTEXT_PATH = './backend'
        KUBECONFIG_CREDENTIALS_ID = 'kubeconfig'
        K8S_DEPLOYMENT_FILE = 'k8s/deployment-backend.yaml'
        tag_version = "${env.BUILD_ID}"
        DISCORD_WEBHOOK_CREDENTIALS_ID = 'discord_webhook'
    }
    stages {
        stage('Build Docker Image') {
            steps {
                script {
                    dockerapp = docker.build("${DOCKER_IMAGE_REPO}:${env.BUILD_ID}", "-f ${DOCKER_FILE_PATH} ${BUILD_CONTEXT_PATH}")
                }
            }
        }

        stage('Push Docker Image') {
            steps {
                script {
                    docker.withRegistry('https://registry.hub.docker.com', 'dockerhub') {
                        dockerapp.push('latest')
                        dockerapp.push("${env.BUILD_ID}")
                    }
                }
            }
        }

        stage('Vulnerability Scan with Trivy') {
            steps {
                script {
                    echo "Starting Trivy vulnerability scan for image: ${DOCKER_IMAGE_REPO}:${tag_version}"
                    bat "trivy image --severity CRITICAL,HIGH --exit-code 1 ${DOCKER_IMAGE_REPO}:${tag_version}"
                    echo "Trivy scan completed."
                }
            }
        }

        stage('Deploy no Kubernetes') {
            steps {
                withKubeConfig([credentialsId: KUBECONFIG_CREDENTIALS_ID]) {
                    //sh para bat usando powershell para o sed
                    bat "powershell -Command \"(Get-Content ${K8S_DEPLOYMENT_FILE}) -replace '{{tag}}', '${tag_version}' | Set-Content ${K8S_DEPLOYMENT_FILE}\""

                    //sh para bat para o 'kubectl apply'
                    bat "kubectl apply -f ${K8S_DEPLOYMENT_FILE}"
                }
            }
        }
    }

    //bloco de ações
    post {
        always {
            //comando de shell windows
            bat "docker logout"
        }
        success {
            echo 'Pipeline completed successfully!'
        script {
                withCredentials([string(credentialsId: DISCORD_WEBHOOK_CREDENTIALS_ID, variable: 'DISCORD_WEBHOOK_URL')]) {
                    discordSend(
                        webhookURL: "${DISCORD_WEBHOOK_URL}",
                        content: "✅ **Pipeline SUCESSO**\nProjeto: `${env.JOB_NAME}`\nBuild: `${env.BUILD_NUMBER}`\nVersão: `${tag_version}`\nStatus: ✅ **Deploy no Kubernetes COMPLETO!**\nLog: ${env.BUILD_URL}",
                        username: "Jenkins",
                        avatarUrl: "https://jenkins.io/images/logos/jenkins/jenkins.png" //ícone do Jenkins
                    )
                }
            }
        }
        failure {
            echo 'Pipeline failed!'
            script {
                withCredentials([string(credentialsId: DISCORD_WEBHOOK_CREDENTIALS_ID, variable: 'DISCORD_WEBHOOK_URL')]) {
                    discordSend(
                        webhookURL: "${DISCORD_WEBHOOK_URL}",
                        content: "❌ **Pipeline FALHOU**\nProjeto: `${env.JOB_NAME}`\nBuild: `${env.BUILD_NUMBER}`\nEstágio: `${env.STAGE_NAME}`\nStatus: ❌ **Falha no Pipeline!**\nLog: ${env.BUILD_URL}",
                        username: "Jenkins",
                        avatarUrl: "https://jenkins.io/images/logos/jenkins/jenkins.png"
                    )
                }
            }
        }
    }