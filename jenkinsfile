pipeline {
    agent any
    environment {
        DOCKER_IMAGE_REPO = 'azisa06/fastapi-hello'
        DOCKER_FILE_PATH = './backend/Dockerfile'
        BUILD_CONTEXT_PATH = './backend'
        KUBECONFIG_CREDENTIALS_ID = 'kubeconfig'
        K8S_DEPLOYMENT_FILE = 'k8s/deployment-backend.yaml'
        tag_version = "${env.BUILD_ID}"
    }
    stages {
        stage('Build Docker Image') {
            steps {
                script {
                    dockerapp = docker.build("${DOCKER_IMAGE_REPO}:${env.BUILD_ID}", "-f ${DOCKER_FILE_PATH} ${BUILD_CONTEXT_PATH}")
                }
            }
        }

        stage('Push Docker Image') {
            steps {
                script {
                    docker.withRegistry('https://registry.hub.docker.com', 'dockerhub') {
                        dockerapp.push('latest')
                        dockerapp.push("${env.BUILD_ID}")
                    }
                }
            }
        }

        stage('Deploy no Kubernetes') {
            steps {
                withKubeConfig([credentialsId: KUBECONFIG_CREDENTIALS_ID]) {
                    //sh para bat usando powershell para o sed
                    bat "powershell -Command \"(Get-Content ${K8S_DEPLOYMENT_FILE}) -replace '{{tag}}', '${tag_version}' | Set-Content ${K8S_DEPLOYMENT_FILE}\""

                    //sh para bat para o 'kubectl apply'
                    bat "kubectl apply -f ${K8S_DEPLOYMENT_FILE}"
                }
            }
        }
    }

    //bloco de ações
    post {
        always {
            //comando de shell, então também deve ser 'bat'
            bat "docker logout"
        }
        success {
            echo 'Pipeline completed successfully!'
        }
        failure {
            echo 'Pipeline failed!'
        }
    }
    //testando webhook do github
}